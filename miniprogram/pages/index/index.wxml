<view class="container" style="padding-top: {{paddingTop}}px">
  <view class="header">
    <view class="title">欢迎来到</view>
    <view class="subtitle">呼噜呼噜的小世界</view>
    <image class="header-illustration" src="https://pic1.imgdb.cn/item/6938113900233646958db1ac.png" mode="aspectFit" />
  </view>

  <view class="app-list">
    <block wx:for="{{appList}}" wx:key="id">
      <navigator class="app-card {{item.className}}" url="{{item.url}}" hover-class="none">
         <view class="card-icon-container">
            <image wx:if="{{item.icon}}" class="card-icon" src="{{item.icon}}" mode="aspectFill" />
            <view wx:else class="card-icon placeholder-icon">
              <text class="icon-emoji">{{item.iconEmoji}}</text>
            </view>
         </view>
         <view class="card-content">
            <view class="card-text">
               <view class="app-name">{{item.name}}</view>
               <view class="app-desc">{{item.desc}}</view>
               <view class="tags">
                  <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="text" class="tag {{tag.color}}">{{tag.text}}</view>
               </view>
            </view>
            <view class="arrow-btn">
              <text class="arrow-icon">></text>
            </view>
         </view>
         <image wx:if="{{item.illustration}}" class="card-illustration" src="{{item.illustration}}" mode="aspectFill" />
         <text wx:elif="{{item.decor}}" class="card-decor">{{item.decor}}</text>
      </navigator>
    </block>

    <!-- More Placeholder -->
    <view class="more-card">
       <text>更多应用建设中...</text>
    </view>
  </view>
</view>
